# GEMINI_API_KEY: Used as an automatic cloud multimodal fallback when local Ollama is unreachable.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Local Ollama OpenAI-compatible endpoint for private local audio inference.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# OLLAMA_MODEL: Local multimodal audio model loaded in Ollama (e.g., qwen2-audio).
OLLAMA_MODEL="qwen2-audio"

# GITHUB_TOKEN: Optional Personal Access Token (repo scope) to push directly to https://github.com/thembaxx/baby.git from the container.
GITHUB_TOKEN=""
